[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/production_planning.gd" id="1"]

[node name="Production Planning" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10
script = ExtResource("1")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Production Planning"

[node name="BuildLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.333333, 0.65098, 1, 1)
text = "Build"

[node name="SummaryLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "No production targets"
horizontal_alignment = 2

[node name="TargetCreator" type="PanelContainer" parent="."]
layout_mode = 2

[node name="CreatorContent" type="VBoxContainer" parent="TargetCreator"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Controls" type="HFlowContainer" parent="TargetCreator/CreatorContent"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Prompt" type="Label" parent="TargetCreator/CreatorContent/Controls"]
layout_mode = 2
text = "New production target"

[node name="ResourceOption" type="OptionButton" parent="TargetCreator/CreatorContent/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 0)
layout_mode = 2

[node name="QuantityLabel" type="Label" parent="TargetCreator/CreatorContent/Controls"]
layout_mode = 2
text = "Quantity"

[node name="QuantitySpinBox" type="SpinBox" parent="TargetCreator/CreatorContent/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
min_value = 1.0
max_value = 1000000000.0
step = 100.0
value = 1000.0
allow_greater = true
allow_lesser = false

[node name="AddTargetButton" type="Button" parent="TargetCreator/CreatorContent/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Add Target"

[node name="PriorityLabel" type="Label" parent="TargetCreator/CreatorContent/Controls"]
layout_mode = 2
text = "Priority"

[node name="PriorityOption" type="OptionButton" parent="TargetCreator/CreatorContent/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(105, 0)
layout_mode = 2

[node name="DeadlineLabel" type="Label" parent="TargetCreator/CreatorContent/Controls"]
layout_mode = 2
text = "Deadline"

[node name="DeadlineSpinBox" type="SpinBox" parent="TargetCreator/CreatorContent/Controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
max_value = 1000000.0
step = 1.0
suffix = " min"
allow_greater = true
allow_lesser = false
tooltip_text = "Optional countdown in simulation minutes; zero means no deadline"

[node name="ControlSpacer" type="Control" parent="TargetCreator/CreatorContent/Controls"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CreatorHint" type="Label" parent="TargetCreator/CreatorContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.65098, 0.721569, 1)
text = "Zero deadline means no time limit. Higher-priority targets receive same-resource production first."
autowrap_mode = 2

[node name="TargetScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="TargetList" type="VBoxContainer" parent="TargetScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Footer" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.65098, 0.721569, 1)
text = "Targets, priorities, deadlines and progress are saved • Capacity status uses live measured throughput"
