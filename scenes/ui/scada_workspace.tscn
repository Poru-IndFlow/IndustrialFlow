[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/scada_workspace.gd" id="1"]

[node name="SCADA" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "SCADA Operations"

[node name="BuildLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.333333, 0.65098, 1, 1)
text = "Build"

[node name="SystemStatus" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "No plant connected"
horizontal_alignment = 2

[node name="FitPlantButton" type="Button" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Fit Plant"
tooltip_text = "Fit all process equipment into the SCADA view"

[node name="ProcessGraph" type="GraphEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
right_disconnects = false
show_arrange_button = false
minimap_enabled = true

[node name="Footer" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.65098, 0.721569, 1)
text = "Read-only operations view • Select equipment for details • Flow brightness indicates line utilisation"
